# ==============================================================================
# AgriN AI Backend Configuration
# ==============================================================================

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
# Powers multimodal Crop Doctor leaf diagnosis, Agricultural Advisor, and AgriVani
GEMINI_API_KEY=

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated or * for local development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# Google Earth Engine (Sentinel-2 Level-2A Multispectral Pipeline)
# ==============================================================================
# Provide GCP project ID and Service Account credentials for LIVE Earth Engine queries.
# If omitted or unconfigured, the backend automatically operates in DEMO / CALCULATED mode
# with explicit data source labeling and never misrepresents simulated data as live data.

EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=

# Path to service account JSON key file (optional if EARTH_ENGINE_PRIVATE_KEY is provided)
EARTH_ENGINE_KEY_FILE=

# Alternatively, paste raw private key string here (with \n escaped or enclosed in quotes)
EARTH_ENGINE_PRIVATE_KEY=

